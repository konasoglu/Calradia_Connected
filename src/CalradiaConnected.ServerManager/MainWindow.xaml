<Window x:Class="CoopServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoopServerManager"
        xmlns:vm="clr-namespace:CoopServerManager.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Lang[WindowTitle]}" 
        Height="900" Width="1380"
        MinHeight="780" MinWidth="1120"
        Background="#0E1117"
        Foreground="#E6E8EE"
        FontFamily="Segoe UI, Inter, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Refined Obsidian-Slate & Burnished Antique Gold Palette -->
        <SolidColorBrush x:Key="BannerlordBgDark" Color="#0E1117" />
        <SolidColorBrush x:Key="BannerlordCardBg" Color="#151A23" />
        <SolidColorBrush x:Key="BannerlordCardAltBg" Color="#1C222E" />
        <SolidColorBrush x:Key="BannerlordInputBg" Color="#11151D" />
        <SolidColorBrush x:Key="BannerlordBorderBrass" Color="#2E3748" />
        <SolidColorBrush x:Key="BannerlordBorderGold" Color="#C9A24B" />
        <SolidColorBrush x:Key="BannerlordGoldAccent" Color="#D8B45A" />
        <SolidColorBrush x:Key="BannerlordGoldBright" Color="#F4D58D" />
        <SolidColorBrush x:Key="BannerlordCrimson" Color="#8C232C" />
        <SolidColorBrush x:Key="BannerlordTextParchment" Color="#E6E8EE" />
        <SolidColorBrush x:Key="BannerlordTextMuted" Color="#8E99AD" />

        <!-- Modern Rounded Button Base Style -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="Background" Value="#212836" />
            <Setter Property="BorderBrush" Value="#3A465C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F4D58D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111620" />
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="CaretBrush" Value="#F4D58D" />
            <Setter Property="SelectionBrush" Value="#C9A24B" />
            <Setter Property="BorderBrush" Value="#323C50" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#D8B45A" />
                                <Setter TargetName="TxtBorder" Property="Background" Value="#171E2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crisp High-Contrast ComboBox Style (Clean Slate + Gold Border) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E8ECF4" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#C9A24B" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="Foreground" Value="#EEF1F6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2D374B" />
                    <Setter Property="Foreground" Value="#F4D58D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sleek Dark Flag Language Selector ComboBox -->
        <Style x:Key="FlagLanguageComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1D2433" />
            <Setter Property="Foreground" Value="#F4D58D" />
            <Setter Property="BorderBrush" Value="#C9A24B" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="LangBorder"
                                                Background="#1D2433"
                                                BorderBrush="#C9A24B"
                                                BorderThickness="1.2"
                                                CornerRadius="6"
                                                Padding="10,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="#F4D58D" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="LangBorder" Property="Background" Value="#252E42" />
                                                <Setter TargetName="LangBorder" Property="BorderBrush" Value="#F4D58D" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#161C27"
                                        BorderBrush="#C9A24B"
                                        BorderThickness="1.2"
                                        CornerRadius="7"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="340" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refined Modern TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#131821" />
            <Setter Property="Foreground" Value="#8E99AD" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="#262F40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B2230" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C9A24B" />
                                <Setter Property="Foreground" Value="#F4D58D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Obsidian DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111620" />
            <Setter Property="Foreground" Value="#E6E8EE" />
            <Setter Property="BorderBrush" Value="#2E3748" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#151A23" />
            <Setter Property="AlternatingRowBackground" Value="#1A212D" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#252D3D" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1D2432" />
            <Setter Property="Foreground" Value="#F4D58D" />
            <Setter Property="BorderBrush" Value="#2E3748" />
            <Setter Property="BorderThickness" Value="0,0,1,1.2" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1. Live Stat Metric Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Tab Control -->
            <RowDefinition Height="*" />
            <!-- 3. Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. TOP HEADER BAR (BRAND, QUICK STATUS & FLAG PICKER)     -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#151A23" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#39445A" BorderThickness="1.2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#8C232C" BorderBrush="#D8B45A" BorderThickness="1.2" CornerRadius="7" Padding="11,6" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Lang[BrandBadge]}" FontWeight="Bold" FontSize="13" Foreground="#FFF8EB" FontFamily="Georgia, Palatino Linotype, serif" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="{Binding Lang[BrandTitle]}" FontWeight="Bold" FontSize="16" Foreground="#F4D58D" VerticalAlignment="Center" FontFamily="Georgia, Palatino Linotype, serif" />
                        <Border Background="#1D2433" BorderBrush="#3A465C" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#C9A24B" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Status, Action Pills & Crisp Vector Flag Language Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Update Button -->
                    <Button Command="{Binding UpdateModCommand}"
                            Content="{Binding UpdateButtonText}"
                            Background="{Binding UpdateButtonBackground}" Foreground="#FFF8EB" BorderBrush="{Binding UpdateButtonBorder}" BorderThickness="1.2"
                            Padding="12,6" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="11.5" />

                    <!-- Direct Connect IP Pill -->
                    <Border Background="#1B2230" CornerRadius="7" Padding="10,5" Margin="0,0,10,0" BorderBrush="#343F54" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Lang[DirectIpLabel]}" FontSize="11.5" Foreground="#8E99AD" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PrimaryLocalIp, FallbackValue='127.0.0.1'}" FontWeight="SemiBold" FontSize="12" Foreground="#F4D58D" VerticalAlignment="Center" />
                            <TextBlock Text=":" FontSize="12" Foreground="#606E87" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerPort}" FontWeight="SemiBold" FontSize="12" Foreground="#F4D58D" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Command="{Binding CopyIpCommand}" Content="{Binding Lang[CopyBtn]}" Background="#2A3346" Foreground="#F3F5F8" BorderBrush="#52627E" BorderThickness="1" Padding="8,3" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Visible Vector Flag Language Selector (8 Languages) -->
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Style="{StaticResource FlagLanguageComboBoxStyle}"
                              Margin="0,0,10,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FlagImage}" Width="24" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NativeName}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Server Status Badge -->
                    <Border Background="{Binding StatusBadgeColor}" BorderBrush="#C9A24B" BorderThickness="1" CornerRadius="7" Padding="14,7">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. LIVE METRIC CARDS ROW                                  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Connected Players -->
            <Border Grid.Column="0" Background="#151A23" CornerRadius="9" Padding="14,11" BorderBrush="#2C3546" BorderThickness="1.2">
                <StackPanel>
                    <TextBlock Text="{Binding Lang[CardPlayers]}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E99AD" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ConnectedPlayerCount, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="#34D399" />
                        <TextBlock Text="{Binding Lang[CardPlayersUnit]}" FontSize="11.5" Foreground="#C4CBD8" VerticalAlignment="Bottom" Margin="5,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: World Time -->
            <Border Grid.Column="2" Background="#151A23" CornerRadius="9" Padding="14,11" BorderBrush="#2C3546" BorderThickness="1.2">
                <StackPanel>
                    <TextBlock Text="{Binding Lang[CardWorldTime]}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E99AD" />
                    <TextBlock Text="{Binding ServerTimeSpeed, FallbackValue='Offline'}" FontSize="14.5" FontWeight="Bold" Foreground="#F4D58D" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CampaignDay, StringFormat='Day: {0:F1}', FallbackValue='Day: 0.0'}" FontSize="10.5" Foreground="#9CA7BA" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Update Rate -->
            <Border Grid.Column="4" Background="#151A23" CornerRadius="9" Padding="14,11" BorderBrush="#2C3546" BorderThickness="1.2">
                <StackPanel>
                    <TextBlock Text="{Binding Lang[CardTickRate]}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E99AD" />
                    <TextBlock Text="{Binding ServerTickRateDisplay, FallbackValue='60 Hz'}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Lang[CardEngine]}" FontSize="10.5" Foreground="#7A869C" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 4: Bandwidth -->
            <Border Grid.Column="6" Background="#151A23" CornerRadius="9" Padding="14,11" BorderBrush="#2C3546" BorderThickness="1.2">
                <StackPanel>
                    <TextBlock Text="{Binding Lang[CardBandwidth]}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E99AD" />
                    <TextBlock Text="{Binding BandwidthDisplay, FallbackValue='50 Mbps'}" FontSize="15" FontWeight="Bold" Foreground="#D8B45A" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding NetworkPollIntervalMs, StringFormat='Poll: {0} ms', FallbackValue='20 ms'}" FontSize="10.5" Foreground="#7A869C" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 5: System Usage -->
            <Border Grid.Column="8" Background="#151A23" CornerRadius="9" Padding="14,11" BorderBrush="#2C3546" BorderThickness="1.2">
                <StackPanel>
                    <TextBlock Text="{Binding Lang[CardRamCpu]}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E99AD" />
                    <TextBlock Text="{Binding ServerLiveRamDisplay, FallbackValue='Offline'}" FontSize="14.5" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ServerLiveCpuDisplay, FallbackValue='Offline'}" FontSize="10.5" Foreground="#9CA7BA" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. MAIN TAB CONTROL                                       -->
        <!-- ======================================================== -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- ==================================================== -->
            <!-- TAB 1: SUNUCU BAŞLAT, ZAMAN VE PERFORMANS KONTROLÜ   -->
            <!-- ==================================================== -->
            <TabItem Header="{Binding Lang[TabControl]}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Module Selection (450px) -->
                        <ColumnDefinition Width="450" />
                        <!-- Splitter -->
                        <ColumnDefinition Width="12" />
                        <!-- Right: Controls, Performance & Live Console (*) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: MODULE MANAGER CARD -->
                    <Border Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Bannerlord Path -->
                                <RowDefinition Height="Auto" /> <!-- Filter & Quick Actions -->
                                <RowDefinition Height="*" />    <!-- Module ListBox -->
                            </Grid.RowDefinitions>

                            <!-- Path Picker -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Lang[GameFolderLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BannerlordPath, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12.5" />
                                    <Button Grid.Column="2" Command="{Binding BrowseBannerlordFolderCommand}" Content="{Binding Lang[BrowseBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderBrush="#374359" BorderThickness="1" Padding="10,0" Cursor="Hand" />
                                </Grid>
                            </StackPanel>

                            <!-- Filter & Quick Select -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12.5" />
                                    <Button Grid.Column="2" Command="{Binding RefreshModulesCommand}" Content="{Binding Lang[RefreshBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderBrush="#374359" BorderThickness="1" Padding="10,0" Cursor="Hand" />
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding SelectAllCustomCommand}" Content="{Binding Lang[SelectAllBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderBrush="#374359" BorderThickness="1" Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                    <Button Command="{Binding DeselectAllCustomCommand}" Content="{Binding Lang[DeselectAllBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderBrush="#374359" BorderThickness="1" Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                    <Button Command="{Binding OpenModulesFolderCommand}" Content="{Binding Lang[ModulesFolderBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderBrush="#374359" BorderThickness="1" Padding="10,3" FontSize="11" Cursor="Hand" />
                                </StackPanel>
                            </Grid>

                            <!-- Module List -->
                            <Border Grid.Row="2" Background="#10141D" CornerRadius="6" BorderBrush="#2C3547" BorderThickness="1" Padding="4">
                                <ListBox ItemsSource="{Binding FilteredModules}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" Margin="0,1" CornerRadius="4" Background="#1A202C">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#FFF4E0" />
                                                            <TextBlock Text="{Binding Version, StringFormat=' ({0})'}" FontSize="10" Foreground="#93A0B4" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#748196" FontFamily="Segoe UI, sans-serif" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#222A3A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#D4AF37" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT: SERVER CONTROLS, PERFORMANCE & LIVE CONSOLE -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <!-- Controls Top Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Splitter -->
                            <RowDefinition Height="12" />
                            <!-- Live Console Output (*) -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- CONTROLS & PERFORMANCE CARD -->
                        <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                            <StackPanel>
                                <!-- Server Name, Save Selection & Big Actions -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.3*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Server Name -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Lang[ServerTitleLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" ToolTip="{Binding Lang[ServerTitleTip]}" />
                                    </StackPanel>

                                    <!-- Server Password -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Lang[ServerPassLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ServerPassword, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" ToolTip="{Binding Lang[ServerPassTip]}" />
                                    </StackPanel>

                                    <!-- Save File Selection -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding Lang[SaveFileLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaveFiles}" SelectedItem="{Binding SelectedSave}" Height="34" FontSize="13" />
                                    </StackPanel>
                                </Grid>

                                <!-- BIG ACTION BUTTONS -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Play on this PC (Player Client) -->
                                    <Button Grid.Column="0" Command="{Binding PlayOnThisPcCommand}" Height="40" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Lang[PlayOnPcBtn]}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Start / Stop Server Button -->
                                    <Button Grid.Column="2" Command="{Binding StartServerCommand}" Height="40" Background="#1E2534" Foreground="#F4D58D" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12.5" Cursor="Hand" Visibility="{Binding StartServerVisibility}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Lang[StartServerBtn]}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Command="{Binding StopServerCommand}" Height="40" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12.5" Cursor="Hand" Visibility="{Binding StopServerVisibility}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Lang[StopServerBtn]}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- DYNAMIC TIME CONTROL BUTTONS -->
                                <Border Background="#10141D" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#2C3547" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Lang[WorldTimeLabel]}" FontWeight="Bold" FontSize="11.5" Foreground="#F4D58D" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding SetTimePauseCommand}" Content="{Binding Lang[TimePauseBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                            <Button Command="{Binding SetTime1xCommand}" Content="{Binding Lang[Time1xBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                            <Button Command="{Binding SetTime2xCommand}" Content="{Binding Lang[Time2xBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                            <Button Command="{Binding SetTime3xCommand}" Content="{Binding Lang[Time3xBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0" />
                                            <Button Command="{Binding SaveWorldCommand}" Content="{Binding Lang[SaveWorldBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding PersistentWorldTime}" Content="{Binding Lang[PersistentTimeChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- PERFORMANCE & NETWORK SETTINGS SLIDERS -->
                                <Border Background="#10141D" CornerRadius="6" Padding="10" BorderBrush="#2C3547" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- TickRate Hz -->
                                        <StackPanel Grid.Column="0">
                                            <Grid>
                                                <TextBlock Text="{Binding Lang[TickRateLabel]}" FontSize="10.5" Foreground="#93A0B4" />
                                                <TextBlock Text="{Binding ServerTickRateDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" FontFamily="Segoe UI, sans-serif" />
                                            </Grid>
                                            <Slider Minimum="20" Maximum="120" Value="{Binding ServerTickRateHz}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Disconnect Timeout -->
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="{Binding Lang[TimeoutLabel]}" FontSize="10.5" Foreground="#93A0B4" />
                                                <TextBlock Text="{Binding DisconnectTimeoutSec, StringFormat='{}{0} s'}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="Segoe UI, sans-serif" />
                                            </Grid>
                                            <Slider Minimum="15" Maximum="180" Value="{Binding DisconnectTimeoutSec}" TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Bandwidth -->
                                        <StackPanel Grid.Column="4">
                                            <Grid>
                                                <TextBlock Text="{Binding Lang[BandwidthLimitLabel]}" FontSize="10.5" Foreground="#93A0B4" />
                                                <TextBlock Text="{Binding BandwidthDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Right" FontFamily="Segoe UI, sans-serif" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="200" Value="{Binding MaxBandwidthMbps}" TickFrequency="25" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Apply Network Button -->
                                        <Button Grid.Column="6" Command="{Binding ApplyNetworkSettingsCommand}" Content="{Binding Lang[ApplyNetBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Padding="12,0" FontWeight="Bold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Height="28" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- LIVE CONSOLE LOGS CARD -->
                        <Border Grid.Row="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Lang[ConsoleHeader]}" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding CopyLogsCommand}" Content="{Binding Lang[CopyAllLogsBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Padding="10,2" FontSize="10.5" Cursor="Hand" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Command="{Binding ClearLogsCommand}" Content="{Binding Lang[ClearBtn]}" Background="#222A3A" Foreground="#93A0B4" BorderBrush="#374359" BorderThickness="1" Padding="10,2" FontSize="10.5" Cursor="Hand" />
                                </Grid>

                                <Border Grid.Row="1" Background="#0C0806" CornerRadius="6" BorderBrush="#4A3416" BorderThickness="1" Padding="4">
                                    <TextBox x:Name="ConsoleTextBox"
                                             Text="{Binding ConsoleText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Consolas, Lucida Console, monospace"
                                             FontSize="11.5"
                                             Foreground="#FFF5E6"
                                             SelectionBrush="#C9A24B"
                                             SelectionOpacity="0.45"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             TextChanged="ConsoleTextBox_TextChanged">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="ApplicationCommands.Copy" Header="{Binding Lang[CtxCopySel]}" />
                                                <MenuItem Command="ApplicationCommands.SelectAll" Header="{Binding Lang[CtxSelectAll]}" />
                                                <Separator />
                                                <MenuItem Command="{Binding CopyLogsCommand}" Header="{Binding Lang[CtxCopyAll]}" />
                                                <MenuItem Command="{Binding ClearLogsCommand}" Header="{Binding Lang[CtxClear]}" />
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================================================== -->
            <!-- TAB 3: KARAKTER BAŞLANGIÇ, STATÜ & İLERLEME AYARLARI  -->
            <!-- ==================================================== -->
            <!-- TAB 2: SUNUCU, DONANIM & KALRADYA OYUN AYARLARI      -->
            <!-- ==================================================== -->
            <TabItem Header="{Binding Lang[TabSettings]}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- Top Header Bar with Save & Reset -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Content ScrollViewer -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP HEADER BANNER -->
                    <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#49566F" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Lang[CfgBannerTitle]}" FontWeight="Bold" FontSize="13.5" Foreground="#F4D58D" />
                                </StackPanel>
                                <TextBlock Text="{Binding Lang[CfgBannerDesc]}" FontSize="11" Foreground="#93A0B4" Margin="0,2,0,0" FontFamily="Segoe UI, sans-serif" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SaveSettingsCommand}" Height="34" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="11.5" Padding="14,0" Cursor="Hand" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[SaveApplyBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetAppliedProgressionCommand}" Height="34" Background="#3A2210" Foreground="#FFA726" BorderBrush="#E65100" BorderThickness="1.5" FontWeight="Bold" FontSize="11.5" Padding="12,0" Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding Lang[ResetProgTip]}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[ResetProgBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetDefaultSettingsCommand}" Height="34" Background="#1E2534" Foreground="#F4D58D" BorderBrush="#C9A24B" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Padding="12,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[DefaultsBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN CONFIGURATION CONTENT (3 CARDS) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: DONANIM, RAM & VRAM TAHSİSİ -->
                            <Border Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[HwHeader]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[MaxRamLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding RamOptions}" SelectedValue="{Binding MaxRamLimitGb}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[MaxRamDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[VramLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding VramOptions}" SelectedValue="{Binding VramBudgetLevel}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[VramDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[ServerFpsLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding FpsOptions}" SelectedValue="{Binding ServerMaxFps}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[ServerFpsDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[CpuCoreLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding CpuCoreOptions}" SelectedValue="{Binding CpuCoresAllocated}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[CpuCoreDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[PriorityLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedValue="{Binding ProcessPriority}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[PriorityDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="Segoe UI, sans-serif" />

                                    <Border Background="#10141D" CornerRadius="6" Padding="10,8" BorderBrush="#2C3547" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding AutoRamCleanEnabled}" Content="{Binding Lang[AutoRamChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Lang[AutoRamDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-4,0,8" FontFamily="Segoe UI, sans-serif" />

                                            <CheckBox IsChecked="{Binding ServerDisableSound}" Content="{Binding Lang[DisableSoundChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[DisableSoundDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,0" FontFamily="Segoe UI, sans-serif" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- COLUMN 2: KALRADYA OYUN & DÜNYA AYARLARI -->
                            <Border Grid.Column="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[GameRulesHeader]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[BattleSizeLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding BattleSizeOptions}" SelectedValue="{Binding BattleSize}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[BattleSizeDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[DamageDiffLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding DamageDifficultyOptions}" SelectedValue="{Binding DamageDifficulty}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[DamageDiffDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[CombatAiLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding CombatAiOptions}" SelectedValue="{Binding CombatAiDifficulty}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[CombatAiDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[HeroDeathLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding HeroDeathOptions}" SelectedValue="{Binding HeroDeathInBattle}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[HeroDeathDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[AutoSaveLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AutoSaveOptions}" SelectedValue="{Binding AutoSaveIntervalMinutes}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[AutoSaveDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[CorpseLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding CorpseOptions}" SelectedValue="{Binding NumberOfCorpses}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[CorpseDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="Segoe UI, sans-serif" />

                                    <Border Background="#10141D" CornerRadius="6" Padding="10,8" BorderBrush="#2C3547" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding PvpEnabled}" Content="{Binding Lang[PvpChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Lang[PvpDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-4,0,8" FontFamily="Segoe UI, sans-serif" />

                                            <CheckBox IsChecked="{Binding PersistentWorldTime}" Content="{Binding Lang[PersistentTimeChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[PersistentTimeDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,6" FontFamily="Segoe UI, sans-serif" />

                                            <CheckBox IsChecked="{Binding ArenaContinuousPracticeRespawn}" Content="{Binding Lang[ArenaRespawnChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding Lang[ArenaRespawnDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,6" FontFamily="Segoe UI, sans-serif" />

                                            <CheckBox IsChecked="{Binding ArenaPvpDuelsEnabled}" Content="{Binding Lang[ArenaDuelChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[ArenaDuelDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,0" FontFamily="Segoe UI, sans-serif" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- COLUMN 4: LOBİ, AĞ & GÜVENLİK YAPILANDIRMASI -->
                            <Border Grid.Column="4" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[LobbyHeader]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[LobbyNameLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding Lang[LobbyPassLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding ServerPassword, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[LobbyPassDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[MaxPlayersLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding MaxPlayersOptions}" SelectedValue="{Binding MaxPlayers}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding Lang[VisibilityLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedValue="{Binding ServerVisibility}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Lang[GamePortLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" Height="32" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Lang[FastDlPortLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding FastDlPort, UpdateSourceTrigger=PropertyChanged}" Height="32" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#10141D" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" BorderBrush="#2C3547" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding EnableFastDl}" Content="{Binding Lang[FastDlChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[FastDlDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,0" FontFamily="Segoe UI, sans-serif" />
                                        </StackPanel>
                                    </Border>

                                    <Button Command="{Binding SaveSettingsCommand}" Height="40" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Lang[ApplyDiskBtn]}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ResetDefaultSettingsCommand}" Height="32" Background="#1E2534" Foreground="#F4D58D" BorderBrush="#C9A24B" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Lang[BalancedResetBtn]}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ==================================================== -->
            <TabItem Header="{Binding Lang[TabProgression]}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP HEADER BANNER -->
                    <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#49566F" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Lang[ProgTitle]}" FontWeight="Bold" FontSize="13.5" Foreground="#F4D58D" />
                                </StackPanel>
                                <TextBlock Text="{Binding Lang[ProgDesc]}" FontSize="11" Foreground="#93A0B4" Margin="0,2,0,0" FontFamily="Segoe UI, sans-serif" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SaveSettingsCommand}" Height="34" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="11.5" Padding="14,0" Cursor="Hand" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[SaveApplyBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetAppliedProgressionCommand}" Height="34" Background="#3A2210" Foreground="#FFA726" BorderBrush="#E65100" BorderThickness="1.5" FontWeight="Bold" FontSize="11.5" Padding="12,0" Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding Lang[ResetProgTip]}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[ResetProgBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetDefaultSettingsCommand}" Height="34" Background="#1E2534" Foreground="#F4D58D" BorderBrush="#C9A24B" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Padding="12,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Lang[DefaultsBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN PROGRESSION CONTENT (4 CARDS GRID) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- CARD 1 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[ProgCard1]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[StartLvlLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding StartingLevelOptions}" SelectedValue="{Binding StartingLevel}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartLvlDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[FocusPtsLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding FocusPointsOptions}" SelectedValue="{Binding StartingFocusPoints}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[FocusPtsDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[AttrPtsLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AttributePointsOptions}" SelectedValue="{Binding StartingAttributePoints}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[AttrPtsDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[MinSkillsLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AllSkillsLevelOptions}" SelectedValue="{Binding StartingAllSkillsLevel}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[MinSkillsDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Segoe UI, sans-serif" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 2 -->
                            <Border Grid.Row="0" Grid.Column="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[ProgCard2]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[CharXpLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding CharacterXpOptions}" SelectedValue="{Binding CharacterXpMultiplier}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[CharXpDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[SkillXpLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding SkillXpOptions}" SelectedValue="{Binding SkillXpMultiplier}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[SkillXpDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <Border Background="#10141D" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" BorderBrush="#2C3547" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Lang[XpInfoTitle]}" FontWeight="Bold" FontSize="11" Foreground="#F4D58D" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[XpInfoDesc]}" FontSize="9.5" Foreground="#93A0B4" TextWrapping="Wrap" FontFamily="Segoe UI, sans-serif" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3 -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[ProgCard3]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[StartGoldLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding StartingGoldOptions}" SelectedValue="{Binding StartingGold}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartGoldDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[StartRenownLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding StartingRenownOptions}" SelectedValue="{Binding StartingRenown}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartRenownDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[StartInflLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding StartingInfluenceOptions}" SelectedValue="{Binding StartingInfluence}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartInflDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Segoe UI, sans-serif" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 4 -->
                            <Border Grid.Row="2" Grid.Column="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                                <StackPanel>
                                    <Border Background="#1E2534" CornerRadius="5" Padding="10,6" Margin="0,0,0,12" BorderBrush="#C9A24B" BorderThickness="1">
                                        <TextBlock Text="{Binding Lang[ProgCard4]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" />
                                    </Border>

                                    <TextBlock Text="{Binding Lang[StartEquipLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding EquipmentPresetOptions}" SelectedValue="{Binding StartingEquipmentPreset}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartEquipDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <TextBlock Text="{Binding Lang[StartTroopsLabel]}" FontSize="11" FontWeight="Bold" Foreground="#93A0B4" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding TroopsPresetOptions}" SelectedValue="{Binding StartingTroopsPreset}" SelectedValuePath="Value" DisplayMemberPath="Title" Height="32" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding Lang[StartTroopsDesc]}" FontSize="9.5" Foreground="#748196" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Segoe UI, sans-serif" />

                                    <Border Background="#10141D" CornerRadius="6" Padding="10,8" Margin="0,4,0,0" BorderBrush="#2C3547" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding StartingFoodSupplies}" Content="{Binding Lang[FoodChk]}" FontWeight="Bold" FontSize="11" Foreground="#E6E8EE" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Lang[FoodDesc]}" FontSize="9.5" Foreground="#748196" Margin="20,-2,0,0" FontFamily="Segoe UI, sans-serif" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- TAB 4: ADMIN TOOLS -->
            <!-- ==================================================== -->
            <TabItem Header="{Binding Lang[TabAdmin]}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP: TARGET PLAYER SELECTOR & STATS BAR -->
                    <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#49566F" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Lang[SelectPlayerLabel]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OnlinePlayers}" SelectedItem="{Binding SelectedPlayer}" DisplayMemberPath="DisplayName" Height="34" FontSize="13" />

                            <TextBlock Grid.Column="2" Text="{Binding Lang[ManualTargetLabel]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="#93A0B4" Margin="14,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding TargetPlayerName, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" ToolTip="{Binding Lang[ManualTargetTip]}" />

                            <Button Grid.Column="4" Command="{Binding RefreshPlayersCommand}" Content="{Binding Lang[RefreshPlayersBtn]}" Background="#222A3A" Foreground="#F4D58D" BorderBrush="#374359" BorderThickness="1" Padding="12,0" FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="10,0,0,0" Height="34" />

                            <!-- Selected Player Quick Stat Preview -->
                            <Border Grid.Column="5" Background="#10141D" CornerRadius="6" Padding="12,5" Margin="14,0,0,0" BorderBrush="#2C3547" BorderThickness="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Lang[TargetBadgePrefix]}" FontSize="11" Foreground="#93A0B4" />
                                    <TextBlock Text="{Binding TargetPlayerName}" FontWeight="Bold" FontSize="11.5" Foreground="#F4D58D" Margin="0,0,10,0" />
                                    <TextBlock Text="💰 " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedPlayer.Gold, StringFormat='{}{0:N0}', FallbackValue='0'}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" Margin="0,0,10,0" FontFamily="Segoe UI, sans-serif" />
                                    <TextBlock Text="📜 " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedPlayer.Renown, StringFormat='{}{0:0.#}', FallbackValue='0'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" Margin="0,0,10,0" FontFamily="Segoe UI, sans-serif" />
                                    <TextBlock Text="👑 " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedPlayer.Influence, StringFormat='{}{0:0.#}', FallbackValue='0'}" FontWeight="Bold" FontSize="11" Foreground="#A855F7" Margin="0,0,10,0" FontFamily="Segoe UI, sans-serif" />
                                    <TextBlock Text="🛡️ " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedPlayer.ArmyStatus, FallbackValue='0/0'}" FontWeight="Bold" FontSize="11" Foreground="#10B981" FontFamily="Segoe UI, sans-serif" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MIDDLE: CHEAT CARDS ROW (4 COLS) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CARD 1: ALTIN (GOLD) YÖNETİMİ -->
                        <Border Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="12" BorderBrush="#374359" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[GoldCardTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="#F59E0B" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Lang[GoldCardDesc]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,8" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button Command="{Binding GiveGoldPresetCommand}" CommandParameter="10000" Content="+10.000 💰" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="28" Margin="2" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveGoldPresetCommand}" CommandParameter="50000" Content="+50.000 💰" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="28" Margin="2" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveGoldPresetCommand}" CommandParameter="100000" Content="+100.000 💰" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="28" Margin="2" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveGoldPresetCommand}" CommandParameter="1000000" Content="+1.000.000 💰" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Height="28" Margin="2" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CheatGoldAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />
                                    <Button Grid.Column="2" Command="{Binding GiveGoldCustomCommand}" Content="{Binding Lang[SendGoldBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Padding="10,0" FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: NAM (RENOWN) & NÜFUZ (INFLUENCE) -->
                        <Border Grid.Column="2" Background="#151A23" CornerRadius="8" Padding="12" BorderBrush="#374359" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[RenownInflTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8" />

                                <TextBlock Text="{Binding Lang[RenownLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,4" />
                                <UniformGrid Columns="4" Margin="0,0,0,4">
                                    <Button Command="{Binding GiveRenownPresetCommand}" CommandParameter="50" Content="+50" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveRenownPresetCommand}" CommandParameter="100" Content="+100" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveRenownPresetCommand}" CommandParameter="250" Content="+250" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveRenownPresetCommand}" CommandParameter="500" Content="+500" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                </UniformGrid>

                                <TextBlock Text="{Binding Lang[InflLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,6,0,4" />
                                <UniformGrid Columns="4" Margin="0,0,0,6">
                                    <Button Command="{Binding GiveInfluencePresetCommand}" CommandParameter="50" Content="+50" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveInfluencePresetCommand}" CommandParameter="100" Content="+100" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveInfluencePresetCommand}" CommandParameter="250" Content="+250" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                    <Button Command="{Binding GiveInfluencePresetCommand}" CommandParameter="500" Content="+500" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Height="26" Margin="1" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: ASKER & ORDU TAKVİYESİ -->
                        <Border Grid.Column="4" Background="#151A23" CornerRadius="8" Padding="12" BorderBrush="#374359" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[TroopsTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="#10B981" Margin="0,0,0,8" />

                                <TextBlock Text="{Binding Lang[EliteTroopsLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding AvailableTroops}" SelectedItem="{Binding SelectedTroop}" DisplayMemberPath="DisplayName" Height="34" FontSize="12.5" Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="75" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CustomTroopId, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12.5" ToolTip="{Binding Lang[CustomTroopTip]}" />
                                    <TextBox Grid.Column="2" Text="{Binding CheatTroopCount, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" ToolTip="{Binding Lang[AmountTip]}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding GiveTroopsCommand}" Content="{Binding Lang[GiveTroopsBtn]}" Background="#059669" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Height="28" FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                    <Button Grid.Column="2" Command="{Binding DuplicateTroopsCommand}" Content="{Binding Lang[DupTroopsBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" Height="28" FontWeight="Bold" FontSize="10.5" Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 4: CAN, ŞİFA & ADMIN YETKİLENDİRME -->
                        <Border Grid.Column="6" Background="#151A23" CornerRadius="8" Padding="12" BorderBrush="#374359" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[HealAdminTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="#F4D58D" Margin="0,0,0,8" />

                                <Button Command="{Binding HealHeroCommand}" Content="{Binding Lang[HealHeroBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="28" Margin="0,0,0,4" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                <Button Command="{Binding HealPartyCommand}" Content="{Binding Lang[HealPartyBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Height="28" Margin="0,0,0,6" Cursor="Hand" FontWeight="Bold" FontSize="11" />
                                <Button Command="{Binding ToggleAdminCommand}" Content="{Binding Lang[ToggleAdminBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" Height="30" Margin="0,0,0,6" Cursor="Hand" FontWeight="Bold" FontSize="11" />

                                <TextBlock Text="{Binding Lang[AdminHint]}" FontSize="9.5" Foreground="#93A0B4" TextWrapping="Wrap" FontFamily="Segoe UI, sans-serif" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BOTTOM: CONNECTED PLAYERS LIVE DATAGRID -->
                    <Border Grid.Row="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Lang[OnlinePlayersTitle]}" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" Margin="0,0,0,8" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding OnlinePlayers}" SelectedItem="{Binding SelectedPlayer}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColUsername], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Username}" Width="1.2*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColHeroName], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding HeroName}" Width="1.5*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColClan], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ClanName}" Width="1.2*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColGold], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Gold, StringFormat='{}{0:N0}'}" Width="*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColRenown], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Renown, StringFormat='{}{0:0.#}'}" Width="0.8*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColInfluence], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Influence, StringFormat='{}{0:0.#}'}" Width="0.8*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColArmy], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ArmyStatus}" Width="1.2*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColHealth], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding HealthStatus}" Width="*" />
                                    <DataGridCheckBoxColumn Header="{Binding DataContext.Lang[ColAdmin], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsAdmin}" Width="0.9*" />
                                    <DataGridCheckBoxColumn Header="{Binding DataContext.Lang[ColConnected], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsConnected}" Width="0.8*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Lang[TabUsers]}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#374359" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Lang[SearchUserLabel]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#93A0B4" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />

                            <CheckBox Grid.Column="3" IsChecked="{Binding AllowAutoRegistration}" Content="{Binding Lang[AutoRegChk]}" FontWeight="Bold" FontSize="11.5" Foreground="#F4D58D" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Lang[UsersTableTitle]}" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding RefreshUsersCommand}" Content="{Binding Lang[RefreshBtn]}" Background="#222A3A" Foreground="#E6E8EE" BorderThickness="1" BorderBrush="#374359" Padding="10,2" FontSize="11" Cursor="Hand" />
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding DataContext.Lang[ColUserUsername], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Username}" Width="1.5*" />
                                        <DataGridTextColumn Header="{Binding DataContext.Lang[ColHeroName], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding HeroName}" Width="1.5*" />
                                        <DataGridTextColumn Header="{Binding DataContext.Lang[ColUserClan], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ClanName}" Width="1.5*" />
                                        <DataGridCheckBoxColumn Header="{Binding DataContext.Lang[ColUserAdmin], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsAdmin}" Width="*" />
                                        <DataGridCheckBoxColumn Header="{Binding DataContext.Lang[ColUserBanned], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding IsBanned}" Width="*" />
                                        <DataGridTextColumn Header="{Binding DataContext.Lang[ColUserCreated], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="1.5*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[NewUserHeader]}" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding Lang[NewUserNameLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding Lang[NewUserPassLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" Margin="0,0,0,6" />

                                    <CheckBox IsChecked="{Binding NewIsAdmin}" Content="{Binding Lang[NewUserAdminChk]}" FontWeight="Bold" FontSize="11" Foreground="#F4D58D" Margin="0,0,0,10" />

                                    <Button Command="{Binding AddUserCommand}" Content="{Binding Lang[CreateAccBtn]}" Height="32" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Margin="0,0,0,16" />

                                    <Border Height="1" Background="#2C3547" Margin="0,0,0,14" />

                                    <TextBlock Text="{Binding Lang[ManageUserHeader]}" FontWeight="Bold" FontSize="12" Foreground="#F4D58D" Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding SelectedUser.Username, FallbackValue='---'}" FontWeight="Bold" FontSize="11.5" Foreground="#FFF4E0" Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding Lang[NewPassResetLabel]}" FontSize="10.5" Foreground="#93A0B4" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ResetPasswordText, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />
                                        <Button Grid.Column="2" Command="{Binding ResetUserPasswordCommand}" Content="{Binding Lang[ResetPassBtn]}" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" Padding="10,0" FontWeight="Bold" FontSize="11" Cursor="Hand" />
                                    </Grid>

                                    <Button Command="{Binding ToggleBanCommand}" Content="{Binding Lang[ToggleBanBtn]}" Height="32" Background="#222A3A" Foreground="#FFF4E0" BorderBrush="#374359" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="0,0,0,8" />

                                    <Button Command="{Binding DeleteUserCommand}" Content="{Binding Lang[DeleteAccBtn]}" Height="32" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="0,0,0,8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Lang[TabClientSync]}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Connect Bar -->
                    <Border Grid.Row="0" Background="#151A23" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#374359" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Lang[ServerIpLabel]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#93A0B4" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding ConnectServerIp, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />

                            <TextBlock Grid.Column="2" Text="{Binding Lang[FastDlLabel]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#93A0B4" Margin="10,0,6,0" />
                            <TextBox Grid.Column="3" Text="{Binding ConnectFastDlPort, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />

                            <TextBlock Grid.Column="4" Text="{Binding Lang[GamePortLabelShort]}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#93A0B4" Margin="10,0,6,0" />
                            <TextBox Grid.Column="5" Text="{Binding ConnectGamePort, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />

                            <Button Grid.Column="7" Command="{Binding CheckServerModsCommand}" Content="{Binding Lang[CheckModsBtn]}" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" Padding="14,4" FontWeight="Bold" FontSize="11.5" Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Main Missing Mods & Download Card -->
                    <Border Grid.Row="1" Background="#151A23" CornerRadius="8" Padding="14" BorderBrush="#374359" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding ClientSyncStatus}" FontSize="12" FontWeight="Bold" Foreground="#F4D58D" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ClientMissingModules}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColModName], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColModId], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Id}" Width="*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColModVersion], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding Version}" Width="*" />
                                    <DataGridTextColumn Header="{Binding DataContext.Lang[ColModSize], RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding FileSizeBytes, StringFormat='{}{0:N0} Byte'}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <ProgressBar Grid.Row="2" Value="{Binding ClientSyncProgress}" Height="14" Margin="0,0,0,10" Background="#10141D" Foreground="#10B981" />

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding DownloadMissingModsCommand}" Height="40" Background="#059669" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Lang[DownloadModsBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding LaunchClientCommand}" Height="40" Background="#8C232C" Foreground="#FFF4E0" BorderBrush="#C9A24B" BorderThickness="1.5" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Lang[LaunchJoinBtn]}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ======================================================== -->
        <!-- 4. FOOTER STATUS BAR                                      -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#151A23" CornerRadius="6" Padding="12,7" Margin="0,10,0,0" BorderBrush="#374359" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#93A0B4" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
                <TextBlock Grid.Column="1" Text="FRZN Software  | Konasoglu" FontSize="11" Foreground="#93A0B4" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI, sans-serif" />
            </Grid>
        </Border>
    </Grid>
</Window>
